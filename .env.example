# Cluster: devnet | rehearsal | mainnet
MARKOV_ENV=devnet
PORT=4000
HOST=0.0.0.0

# Solana RPC (never commit values)
RPC_HTTP_URL=
RPC_WS_URL=
RPC_HTTP_FALLBACK=https://api.devnet.solana.com

# Program IDs come from packages/facts. Override only in a local fork.
# MARKOV_PROGRAM_ID=

# Postgres (production). Empty = JSON file at $MARKOV_DATA_DIR/control-plane.json (local). `memory` disables persist (tests).
DATABASE_URL=
MARKOV_DATA_DIR=

# Redis (optional). Empty = in-process queues, not for production keeper.
REDIS_URL=

# Auth
JWT_SECRET=
SIWS_DOMAIN=localhost:3000

# Keeper signer: path or KMS. Never a raw secret in a client env.
KEEPER_KEYPAIR=
ADMIN_KEYPAIR=

# Terminal / landing (public)
NEXT_PUBLIC_ENV=devnet
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pacifica (owner-signed; no agent key by default)
PACIFICA_API_URL=https://api.pacifica.fi/api/v1
PACIFICA_TESTNET_API_URL=https://test-api.pacifica.fi/api/v1

# Phoenix (mainnet reads)
PHOENIX_API_URL=https://perp-api.phoenix.trade
