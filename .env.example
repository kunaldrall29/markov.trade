# Every variable the system reads. Values are blank on purpose (docs/09 §4);
# defaults are in the comments and in each crate's config. Never commit a filled copy.
# Program IDs and mints come from docs/FACTS.md.
CLUSTER=                     # devnet only in Gate B
# Keyless devnet endpoints proven on 2026-09-02 (docs/FACTS.md RPC_*).
# Run scripts/rpc-check.sh before putting any new URL here: it refuses
# anything whose genesis hash is not devnet's.
RPC_HTTP_URL=                # default https://rpc.magicblock.app/devnet (keyless; 25/25 concurrent, finished a chunked IDL publish)
RPC_WS_URL=                  # default wss://api.devnet.solana.com (keyless; logsSubscribe proven to deliver)
RPC_HTTP_FALLBACK=           # default https://api.devnet.solana.com (keyless; 429s on bursts)
PROGRAM_ID=
DEMO_PERPS_ID=
USDC_D_MINT=
SOL_D_MINT=
# keys: exactly one service per key, never the repo
OPERATOR_KEYPAIR=            # book-one only (P07)
EMERGENCY_KEYPAIR=           # bot only (P13)
OWNER_DEMO_KEYPAIR=          # demo scripts only
MARK_POSTER_KEYPAIR=         # mark-poster job only (P04)
# mark source (ADR-003): onchain | house | replay
MARK_SOURCE=                 # default onchain
PYTH_PRICE_UPDATE_ACCOUNT=   # default 7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE (FACTS)
SOL_USD_FEED_ID=             # default ef0d8b6f…b56d (FACTS)
MARK_MAX_AGE_SECS=           # default 150
HERMES_URL=                  # only for MARK_SOURCE=house; keyed since 2026-08-26
HERMES_API_KEY=
# agent
VENUE=                       # shadow (P08) | devnet (P07)
TICK_SECONDS=                # default 60, floor 60
PER_TX_CAP=                  # default 50 (mint base units)
MAX_ACTIONS_PER_HOUR=        # default 6 (P07)
DAILY_LOSS_HALT_BPS=         # default 500 (P07)
REDTEAM_ENABLED=             # default false (P07)
REDTEAM_CRON=                # (P07)
SIDECAR=                     # default stub
PAPER_DIR=                   # default paper
PAPER_START_DATE=            # required in shadow mode; YYYY-MM-DD; from FACTS, never edited
MAX_TICKS=                   # unset = run forever; set for smoke tests
HALT=                        # (P07)
# read plane
DATABASE_URL=                # indexer, read-write role (P09)
DATABASE_URL_RO=             # data-api, read-only role (P10)
LAG_SLOTS=                   # derived from FACTS DEVNET_SLOT_MS (P10)
BACKFILL_FROM=               # (P09)
# bot
TELEGRAM_BOT_TOKEN=          # (P13)
TELEGRAM_ALLOWLIST=          # (P13)
# web (public by nature)
VITE_API_BASE=
VITE_CLUSTER=
VITE_PROGRAM_ID=
# observability
SENTRY_DSN_AGENT=
SENTRY_DSN_INDEXER=
SENTRY_DSN_API=
SENTRY_DSN_WEB=
