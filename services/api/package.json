    "@markov/risk": "workspace:*",
    "@markov/router": "workspace:*",
    "@markov/sdk": "workspace:*",
    "fastify": "^5.2.1",
    "tweetnacl": "^1.0.3",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
