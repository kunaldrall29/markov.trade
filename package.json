{
  "name": "markov",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:api": "pnpm --filter @markov/api dev",
    "dev:terminal": "pnpm --filter @markov/terminal dev",
    "dev:landing": "pnpm --filter @markov/landing dev",
    "dev:mcp": "pnpm --filter @markov/mcp dev",
    "dev:keeper": "pnpm --filter @markov/keeper dev",
    "smoke:pacifica": "pnpm --filter @markov/adapters smoke:pacifica",
    "smoke:phoenix": "pnpm --filter @markov/adapters smoke:phoenix",
    "smoke:jupiter": "pnpm --filter @markov/adapters smoke:jupiter",
    "check:facts": "pnpm --filter @markov/facts check",
    "check:claims": "node scripts/check-claims.mjs",
    "check:keys": "bash scripts/no-keys-in-tree.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
