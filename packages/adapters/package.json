{
  "name": "@markov/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "smoke:pacifica": "node --import tsx src/smoke/pacifica.ts",
    "smoke:phoenix": "node --import tsx src/smoke/phoenix.ts",
    "smoke:jupiter": "node --import tsx src/smoke/jupiter.ts",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@markov/facts": "workspace:*",
    "@markov/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
